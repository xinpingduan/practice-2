MODEL=your-chat-model
AGENT_API_KEY=replace-with-a-random-agent-api-key
AI_ASSISTANT_ENABLED=true
AI_REQUESTS_PER_WINDOW=12
AI_RATE_LIMIT_WINDOW_SECONDS=300
AI_MAX_HISTORY_MESSAGES=8
AI_MAX_STORED_MESSAGES=40
AI_MEMORY_TYPE=buffer
AI_MEMORY_WINDOW_MESSAGES=8
AI_MEMORY_TOKEN_LIMIT=4000
AI_MEMORY_MAX_CHARACTERS=16000
AI_MEMORY_SUMMARY_MAX_CHARACTERS=3000
