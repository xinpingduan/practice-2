DB_HOST=localhost
DB_PORT=3306
DB_USER=employee_app
DB_PASSWORD=replace-with-a-local-database-password
DB_DATABASE=employee_management_db
FLASK_SECRET_KEY=replace-with-a-local-random-secret
APP_ENV=development
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_HOURS=8
TRUST_PROXY_HEADERS=false
CREATE_DEMO_DATA=false
DEMO_ACCOUNT_PASSWORD=
AUTO_INITIALIZE_DATABASE=true
APP_DEBUG=false
MAX_CONTENT_LENGTH=2097152
DEEPSEEK_API_KEY=请填写兼容OpenAI接口的模型密钥
