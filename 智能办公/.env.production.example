DB_DATABASE=employee_management_db
DB_USER=employee_app
DB_PASSWORD=replace-with-a-long-random-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-root-password
FLASK_SECRET_KEY=replace-with-a-random-string-of-at-least-32-characters
SESSION_LIFETIME_HOURS=8
MAX_CONTENT_LENGTH=2097152
AUTO_INITIALIZE_DATABASE=false
APP_DEBUG=false
DEEPSEEK_API_KEY=replace-with-provider-api-key
DEEPSEEK_BASE_URL=https://api.example.com/v1
MODEL=your-chat-model
AI_ASSISTANT_ENABLED=true
AI_REQUESTS_PER_WINDOW=12
AI_RATE_LIMIT_WINDOW_SECONDS=300
AI_MAX_HISTORY_MESSAGES=8
AI_MAX_STORED_MESSAGES=40
AI_MEMORY_TYPE=buffer
AI_MEMORY_WINDOW_MESSAGES=8
AI_MEMORY_TOKEN_LIMIT=4000
AI_MEMORY_MAX_CHARACTERS=16000
AI_MEMORY_SUMMARY_MAX_CHARACTERS=3000
AI_CONVERSATION_RETENTION_DAYS=30
